# Prabodh frontend (apps/web) — local environment template.
# Copy to `.env.local` in this directory and fill in real values. NEVER commit `.env.local`.
# All variables here are public by Next.js convention (NEXT_PUBLIC_* is exposed to the
# browser bundle) — never put a secret in this file or in `.env.local`.

NEXT_PUBLIC_LEARNHOUSE_BACKEND_URL=http://localhost:1338
NEXT_PUBLIC_LEARNHOUSE_API_URL=http://localhost:1338/api/v1/
NEXT_PUBLIC_LEARNHOUSE_DOMAIN=localhost:3000
NEXT_PUBLIC_LEARNHOUSE_TOP_DOMAIN=localhost
NEXT_PUBLIC_LEARNHOUSE_HTTPS=false
NEXT_PUBLIC_LEARNHOUSE_MULTI_ORG=false
NEXT_PUBLIC_LEARNHOUSE_DEFAULT_ORG=default
NEXT_PUBLIC_LEARNHOUSE_PLATFORM_URL=
NEXT_PUBLIC_COLLAB_URL=http://localhost:4000
# Optional analytics — leave blank to disable.
NEXT_PUBLIC_POSTHOG_KEY=
