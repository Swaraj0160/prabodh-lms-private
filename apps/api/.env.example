# Prabodh backend (apps/api) — local environment template.
# Copy to `.env` in this directory and fill in real values. NEVER commit `.env`.

# ── Core ──────────────────────────────────────────────────────────────────
LEARNHOUSE_ENV=development
LEARNHOUSE_PORT=1338
LEARNHOUSE_TENANCY=single
LEARNHOUSE_DOMAIN=localhost
LEARNHOUSE_FRONTEND_DOMAIN=localhost:3000
LEARNHOUSE_COOKIE_DOMAIN=localhost
LEARNHOUSE_ALLOWED_ORIGINS=http://localhost:3000
LEARNHOUSE_SSL=false
LEARNHOUSE_SELF_HOSTED=true
LEARNHOUSE_SAAS=false
LEARNHOUSE_USE_DEFAULT_ORG=true

# ── Auth (required) ──────────────────────────────────────────────────────
# A long random string — used to sign session/auth JWTs.
LEARNHOUSE_AUTH_JWT_SECRET_KEY=

# ── Database / Redis (required) ─────────────────────────────────────────
LEARNHOUSE_SQL_CONNECTION_STRING=postgresql+asyncpg://learnhouse:learnhouse@localhost:5432/learnhouse
LEARNHOUSE_REDIS_CONNECTION_STRING=redis://localhost:6379

# ── AI / Gemini (optional — leave is_ai_enabled false until configured) ──
# Provider-agnostic: also supports "anthropic", "openai", "ollama", etc.
# See config/config.yaml's ai_config section for full provider documentation.
LEARNHOUSE_IS_AI_ENABLED=false
LEARNHOUSE_AI_PROVIDER=google
LEARNHOUSE_AI_API_KEY=
LEARNHOUSE_AI_BASE_URL=
LEARNHOUSE_AI_MODEL_FAST=
LEARNHOUSE_AI_MODEL_STANDARD=
LEARNHOUSE_AI_MODEL_PRO=
LEARNHOUSE_AI_EMBEDDING_PROVIDER=
LEARNHOUSE_AI_EMBEDDING_MODEL=
LEARNHOUSE_AI_EMBEDDING_DIMENSIONS=
LEARNHOUSE_AI_IMAGE_MODEL=
LEARNHOUSE_AI_TTS_MODEL=
# Legacy/secondary Google key — only needed if LEARNHOUSE_AI_PROVIDER is not
# "google" but you still want Google-powered embeddings/image/audio.
LEARNHOUSE_GEMINI_API_KEY=

# ── Email (optional) ─────────────────────────────────────────────────────
LEARNHOUSE_EMAIL_PROVIDER=
LEARNHOUSE_SYSTEM_EMAIL_ADDRESS=
LEARNHOUSE_CONTACT_EMAIL=
LEARNHOUSE_RESEND_API_KEY=
LEARNHOUSE_SMTP_HOST=
LEARNHOUSE_SMTP_PORT=
LEARNHOUSE_SMTP_USERNAME=
LEARNHOUSE_SMTP_PASSWORD=
LEARNHOUSE_SMTP_USE_TLS=

# ── OAuth (optional) ─────────────────────────────────────────────────────
LEARNHOUSE_GOOGLE_CLIENT_ID=
LEARNHOUSE_GOOGLE_OAUTH_CLIENT_ID=

# ── Billing / Stripe (optional, SaaS deployments only) ──────────────────
LEARNHOUSE_STRIPE_SECRET_KEY=
LEARNHOUSE_STRIPE_PUBLISHABLE_KEY=
LEARNHOUSE_STRIPE_CLIENT_ID=
LEARNHOUSE_STRIPE_WEBHOOK_STANDARD_SECRET=
LEARNHOUSE_STRIPE_WEBHOOK_CONNECT_SECRET=

# ── Content storage (optional — defaults to local filesystem) ───────────
LEARNHOUSE_CONTENT_DELIVERY_TYPE=filesystem

# ── Observability / analytics (optional) ─────────────────────────────────
LEARNHOUSE_SENTRY_DSN=
LEARNHOUSE_TINYBIRD_API_URL=
LEARNHOUSE_TINYBIRD_INGEST_TOKEN=
LEARNHOUSE_TINYBIRD_READ_TOKEN=

# ── Platform / internal (optional) ───────────────────────────────────────
LEARNHOUSE_PLATFORM_API_KEY=
LEARNHOUSE_SITE_NAME=Prabodh
LEARNHOUSE_SITE_DESCRIPTION=

# ── Collaboration service internal key (must match apps/collab/.env) ────
COLLAB_INTERNAL_KEY=
